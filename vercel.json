{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/mock", "destination": "/mock.html" },
    { "source": "/showcase", "destination": "/showcase.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
