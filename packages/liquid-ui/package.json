{
  "name": "@sus_69/liquid-ui",
  "version": "0.2.0",
  "type": "module",
  "description": "Reusable liquid-glass UI components powered by a shared WebGL2/WebGPU rendering engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sus69/liquid-glass-studio.git",
    "directory": "packages/liquid-ui"
  },
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "webgl",
    "webgpu",
    "react",
    "ui-components",
    "shaders",
    "squircles"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/types/styles', {recursive:true}); fs.copyFileSync('src/styles/styles.css', 'dist/types/styles/styles.css'); fs.writeFileSync('dist/types/styles/styles.css.d.ts', 'declare const styles: {}; export default styles;\\n');\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@react-spring/web": ">=9.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-glsl": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
